parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc tag @var with type ModelflowAi\\DecisionTree\\DecisionTreeInterface\<ModelflowAi\\Chat\\Request\\AIChatRequest, ModelflowAi\\Chat\\Adapter\\AIChatAdapterInterface\> is not subtype of native type ModelflowAi\\DecisionTree\\DecisionTree\<ModelflowAi\\DecisionTree\\Behaviour\\CriteriaBehaviour, ModelflowAi\\DecisionTree\\Behaviour\\SupportsBehaviour\>\.$#'
			identifier: varTag.nativeType
			count: 1
			path: examples/chat/bootstrap.php

		-
			message: '#^Parameter \#1 \$client of class ModelflowAi\\OllamaAdapter\\Chat\\OllamaChatAdapter constructor expects ModelflowAi\\Ollama\\ClientInterface, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: examples/chat/bootstrap.php

		-
			message: '#^Binary operation "\." between non\-falsy\-string and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: examples/chat/chat-response-format.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: examples/chat/chat-response-format.php

		-
			message: '#^PHPDoc tag @var with type ModelflowAi\\DecisionTree\\DecisionTreeInterface\<ModelflowAi\\Completion\\Request\\AICompletionRequest, ModelflowAi\\Completion\\Adapter\\AICompletionAdapterInterface\> is not subtype of native type ModelflowAi\\DecisionTree\\DecisionTree\<ModelflowAi\\DecisionTree\\Behaviour\\CriteriaBehaviour, ModelflowAi\\DecisionTree\\Behaviour\\SupportsBehaviour\>\.$#'
			identifier: varTag.nativeType
			count: 1
			path: examples/completion/bootstrap.php

		-
			message: '#^Parameter \#1 \$client of class ModelflowAi\\OllamaAdapter\\Completion\\OllamaCompletionAdapter constructor expects ModelflowAi\\Ollama\\ClientInterface, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: examples/completion/bootstrap.php

		-
			message: '#^Parameter \#1 \$client of class ModelflowAi\\OllamaAdapter\\Embeddings\\OllamaEmbeddingAdapter constructor expects ModelflowAi\\Ollama\\ClientInterface, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: examples/embeddings/bootstrap.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
