parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$apiKey of static method ModelflowAi\\Anthropic\\Anthropic\:\:client\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: examples/messages-streamed.php

		-
			message: '#^Using nullsafe property access "\?\-\>text" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: examples/messages-streamed.php

		-
			message: '#^Parameter \#1 \$apiKey of static method ModelflowAi\\Anthropic\\Anthropic\:\:client\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: examples/messages.php

		-
			message: '#^Parameter \#1 \$apiKey of method ModelflowAi\\Anthropic\\Factory\:\:withApiKey\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: examples/tools.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/Resources/Messages.php

		-
			message: '#^Call to static method Webmozart\\Assert\\Assert\:\:allString\(\) with list\<string\> will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: src/Resources/Messages.php

		-
			message: '#^Call to static method Webmozart\\Assert\\Assert\:\:isArray\(\) with array\{type\: ''text''\|''tool_use''.*\} will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: src/Resources/Messages.php

		-
			message: '#^Cannot access offset ''content'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Resources/Messages.php

		-
			message: '#^Cannot access offset ''role'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Resources/Messages.php

		-
			message: '#^Parameter \#1 \$array of static method Webmozart\\Assert\\Assert\:\:keyExists\(\) expects array, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: src/Resources/Messages.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\ClientInterface'' and ModelflowAi\\Anthropic\\ClientInterface will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: tests/Unit/AnthropicTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\Factory'' and ModelflowAi\\Anthropic\\Factory will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: tests/Unit/AnthropicTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\ClientInterface'' and ModelflowAi\\Anthropic\\ClientInterface will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: tests/Unit/FactoryTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\Factory'' and ModelflowAi\\Anthropic\\Factory will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 5
			path: tests/Unit/FactoryTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\Responses\\\\Messages\\\\CreateResponseContent'' and ModelflowAi\\Anthropic\\Responses\\Messages\\CreateResponseContent will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: tests/Unit/Resources/MessagesTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\Responses\\\\Messages\\\\CreateResponseContent'' and ModelflowAi\\Anthropic\\Responses\\Messages\\CreateResponseContent will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 2
			path: tests/Unit/Responses/Chat/CreateResponseContentTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\Responses\\\\Messages\\\\CreateResponseContentToolUse'' and ModelflowAi\\Anthropic\\Responses\\Messages\\CreateResponseContentToolUse will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: tests/Unit/Responses/Chat/CreateResponseContentToolUseTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\Anthropic\\\\Responses\\\\Messages\\\\CreateResponseContent'' and ModelflowAi\\Anthropic\\Responses\\Messages\\CreateResponseContent will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 1
			path: tests/Unit/Responses/Chat/CreateResponseTest.php

		-
			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''ModelflowAi\\\\ApiClient\\\\Responses\\\\MetaInformation'' and ModelflowAi\\ApiClient\\Responses\\MetaInformation will always evaluate to true\.$#'
			identifier: method.alreadyNarrowedType
			count: 2
			path: tests/Unit/Responses/Chat/CreateResponseTest.php
